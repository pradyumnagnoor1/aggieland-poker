# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# URL-encode special characters in the password. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres
DATABASE_SSL=true
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Actual public origin, with no trailing slash. Configure separately in previews.
APP_ORIGIN=http://127.0.0.1:3000
# Random 32+ character secret for authenticated expiration endpoint.
CRON_SECRET=
# Optional HMAC key for privacy-preserving abuse-control identifiers.
RATE_LIMIT_SECRET=
# Set true ONLY for synthetic local/staging demonstrations, never production.
DEMO_MODE=false
# Local demonstration authentication is blocked in production and on Vercel.
LOCAL_DEMO_PASSWORD=
